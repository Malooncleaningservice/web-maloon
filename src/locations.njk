---
layout: base.njk
pageKey: locations
locale: en
permalink: /locations.html
---

{% set localeData = en %}
{% set pageData = localeData.pages.locations %}

{# Hero placeholder #}
<div id="locations-hero-placeholder"></div>

{# Service Areas Section #}
<section class="service-areas-section section-white section-spacing reveal">
    <div class="container">
        <div class="section-header-center">
            <h2>{{ localeData.locations.title }}</h2>
            <p>{{ localeData.locations.subtitle }}</p>
        </div>
        
        <figure class="areas-map reveal" style="max-width: 460px; margin: 0 auto; text-align: center;">
            <img src="/assets/images/locations-storefront.webp"
                 alt="Commercial building with freshly cleaned windows in Columbus, OH"
                 width="800" height="1067"
                 style="width: 100%; height: auto; border-radius: var(--radius-card); border: 1px solid var(--sage-soft); box-shadow: var(--elevation-1); display: block;"
                 loading="lazy">
            <figcaption style="font-size: 13px; color: var(--text-muted); margin-top: 8px;">A Columbus business we serve</figcaption>
        </figure>

        <div class="areas-grid">
            {% set areasPerColumn = (localeData.locations.areas.length / 3) | round %}
            <div class="areas-column">
                {% for area in localeData.locations.areas.slice(0, 6) %}
                <div class="area-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <span>{{ area }}</span>
                </div>
                {% endfor %}
            </div>
            <div class="areas-column">
                {% for area in localeData.locations.areas.slice(6, 12) %}
                <div class="area-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <span>{{ area }}</span>
                </div>
                {% endfor %}
            </div>
            <div class="areas-column">
                {% for area in localeData.locations.areas.slice(12) %}
                <div class="area-item">
                    <i class="fas fa-map-marker-alt"></i>
                    <span>{{ area }}</span>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

{# Why Choose Us placeholder #}
<div id="locations-why-choose-placeholder"></div>
