---
layout: base.njk
pageKey: residential
locale: en
permalink: /residential.html
---

{% set localeData = en %}
{% set pageData = localeData.pages.residential %}

{# Hero #}
<section class="hero" style="background-image: linear-gradient(135deg, rgba(27,94,32,0.85) 0%, rgba(46,125,50,0.75) 100%), url('https://images.unsplash.com/photo-1527515637462-cff94eecc1ac?ixlib=rb-1.2.1&auto=format&fit=crop&w=1920&q=80');">
    <div class="hero-content">
        <h1>{{ localeData.pages.residential.hero.title }}</h1>
        <h2>{{ localeData.pages.residential.hero.subtitle }}</h2>
        <a href="{{ localeData.pages.residential.cta.whatsapp_url }}" class="btn-primary">
            <i class="fab fa-whatsapp"></i>
            Get a Free Quote
        </a>
    </div>
</section>

{# Residential Overview #}
<section id="residential-overview" class="services-overview section-white section-spacing reveal">
    <div class="container">
        <div class="section-header-center">
            <h2>{{ localeData.services.residential.title }}</h2>
            <p>{{ localeData.services.residential.subtitle }}</p>
        </div>
        <div class="features-grid">
            {% for category in localeData.services.residential.categories %}
            <div class="service-card reveal">
                <div class="icon-badge">{{ category.icon }}</div>
                <h3>{{ category.title }}</h3>
                <p>{{ category.description }}</p>
                <ul class="checkmark-list">
                    {% for detail in category.details %}
                    <li>{{ detail }}</li>
                    {% endfor %}
                </ul>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

{# Service Details with Split Sections #}
{% for category in localeData.services.residential.categories %}
<section id="{{ category.title | lower | replace(' ', '-') | replace('/', '-') }}" class="service-section section-spacing reveal">
    <div class="container">
        <div class="split-section {% if loop.index % 2 == 0 %}reverse{% endif %} reveal">
            <div class="split-content">
                <div class="icon-badge-large">{{ category.icon }}</div>
                <h3>{{ category.title }}</h3>
                <p>{{ category.description }}</p>
                <ul class="checkmark-list">
                    {% for detail in category.details %}
                    <li>{{ detail }}</li>
                    {% endfor %}
                </ul>
            </div>
            <div class="split-image">
                <img src="https://images.unsplash.com/photo-1527515637462-cff94eecc1ac?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80" alt="{{ category.title }}">
            </div>
        </div>
    </div>
</section>
{% endfor %}

{# Why Choose Us #}
<section id="residential-why-choose" class="section-green section-spacing reveal">
    <div class="container">
        <div class="section-header-center reveal">
            <h2 style="color: var(--white);">{{ localeData.why_us.title }}</h2>
        </div>
        <div class="features-grid-3">
            {% for feature in localeData.why_us.features %}
            <div class="feature-card reveal">
                <div class="feature-icon">{{ feature.icon }}</div>
                <h3>{{ feature.title }}</h3>
                <p>{{ feature.description }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

{# CTA #}
<section id="residential-cta" class="final-cta reveal">
    <div class="container">
        <h2 class="cta-h">{{ localeData.pages.residential.cta.title }}</h2>
        <p class="cta-sub">Serving Columbus homes — Mon to Sat</p>
        <div class="cta-buttons">
            <a href="{{ localeData.pages.residential.cta.whatsapp_url }}" class="btn-cta-sparkle">
                <i class="fab fa-whatsapp"></i>
                Message us on WhatsApp
            </a>
        </div>
    </div>
</section>
